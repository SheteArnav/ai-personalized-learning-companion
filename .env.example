# ==========================================
# Synapse AI Environment Configuration
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# AI Provider Strategy: 'demo' | 'gemini' | 'openai'
# If set to 'demo' (or no API key provided), the app operates in offline High-Fidelity Demo Mode
AI_PROVIDER=demo

# Optional: LLM Provider API Keys (Leave empty for zero-dependency Demo Mode)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_API_KEY=your_general_ai_api_key_here

# Force Demo Mode flag (true/false)
DEMO_MODE=false
